<Window x:Class="TaxExpenseTrackerDevLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Tax Expense Tracker Dev Launcher"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Closed="Window_Closed">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="25" FontWeight="SemiBold" Text="Tax Expense Tracker" />
                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Local development launcher" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding StartAllCommand}" Content="Start all" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Command="{Binding StopAllCommand}" Content="Stop all" />
                <Button Command="{Binding RestartAllCommand}" Content="Restart all" Margin="0" />
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Services}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,12,0" Padding="16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White" Text="{Binding DisplayName}" />
                                <Border Grid.Column="1" Padding="9,3" Background="{StaticResource ElevatedSurfaceBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="3">
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Text="{Binding StateText}" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,12,0,12" Orientation="Horizontal">
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="PID " />
                                <TextBlock FontWeight="SemiBold" Text="{Binding ProcessText}" />
                                <TextBlock Margin="18,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Uptime " />
                                <TextBlock FontWeight="SemiBold" Text="{Binding Uptime}" />
                                <TextBlock Margin="18,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Ports " />
                                <TextBlock FontWeight="SemiBold" Foreground="White" Text="{Binding PortsText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Command="{Binding StartCommand}" Content="Start" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Command="{Binding StopCommand}" Content="Stop" />
                                <Button Command="{Binding RestartCommand}" Content="Restart" />
                                <Button Command="{Binding ForceFreePortCommand}"
                                    Content="Force free port"
                                    Visibility="{Binding HasPortConflict, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="{Binding Definition.LocalUri}" RequestNavigate="LocalLink_RequestNavigate">
                                        <Run Text="{Binding LocalUrl, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Row="3"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Text="{Binding PortConflictText}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasPortConflict, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Height="1" Margin="0,0,0,12" Background="{StaticResource BorderBrush}" />

        <TabControl Grid.Row="3">
            <TabItem Header="Logs">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter log text" />
                        <CheckBox Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Content="API" IsChecked="{Binding ShowApiLogs}" />
                        <CheckBox Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Content="Web" IsChecked="{Binding ShowWebLogs}" />
                        <CheckBox Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Center" Content="Auto-scroll" IsChecked="{Binding AutoScroll}" />
                        <Button Grid.Column="5" Command="{Binding ClearLogsCommand}" Content="Clear" />
                        <Button Grid.Column="6" Command="{Binding SaveLogsCommand}" Content="Save" Margin="0" />
                    </Grid>
                    <ListView x:Name="LauncherLogList"
                              Grid.Row="1"
                              ItemsSource="{Binding LogsView}"
                              FontFamily="Cascadia Mono"
                              FontSize="12"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Width="95" DisplayMemberBinding="{Binding TimestampText}" Header="Time" />
                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding ServiceId}" Header="Service" />
                                <GridViewColumn Width="75" DisplayMemberBinding="{Binding Stream}" Header="Stream" />
                                <GridViewColumn Width="760" DisplayMemberBinding="{Binding Text}" Header="Message" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="Frontend Output">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FrontendOutputFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter frontend output" />
                        <CheckBox Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" Content="Auto-scroll" IsChecked="{Binding FrontendOutputAutoScroll}" />
                        <Button Grid.Column="2" Command="{Binding WebService.StartCommand}" Content="Start" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="3" Command="{Binding WebService.StopCommand}" Content="Stop" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Status " />
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Text="{Binding WebService.StateText}" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="FrontendOutputList"
                              Grid.Row="1"
                              ItemsSource="{Binding FrontendLogsView}"
                              FontFamily="Cascadia Mono"
                              FontSize="12"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Width="95" DisplayMemberBinding="{Binding TimestampText}" Header="Time" />
                                <GridViewColumn Width="80" DisplayMemberBinding="{Binding Stream}" Header="Stream" />
                                <GridViewColumn Width="900" DisplayMemberBinding="{Binding Text}" Header="npm / Angular output" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="API Log Files">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ApiLogFiles}"
                                  SelectedItem="{Binding SelectedApiLogFile}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Select an API log file" />
                        <TextBox Grid.Column="1" Margin="10,0,0,0" Text="{Binding ApiLogFileFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter API file logs" />
                        <CheckBox Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Content="Auto-scroll" IsChecked="{Binding ApiLogFileAutoScroll}" />
                        <Button Grid.Column="4" Command="{Binding RefreshApiLogFilesCommand}" Content="Refresh" />
                        <Button Grid.Column="5" Command="{Binding OpenApiLogFolderCommand}" Content="Open folder" Margin="0" />
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="2,0,0,8" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ApiLogFileStatus}" />
                    <ListView x:Name="ApiLogFileList"
                              Grid.Row="2"
                              ItemsSource="{Binding ApiLogFileLinesView}"
                              FontFamily="Cascadia Mono"
                              FontSize="12"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Width="1050" DisplayMemberBinding="{Binding Text}" Header="API file output" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            <TabItem Header="App">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="ReloadWebView_Click" Content="Reload" />
                        <Button Grid.Column="1" Command="{Binding OpenFrontendCommand}" Content="Open in browser" />
                        <Border Grid.Column="2" Width="1" Margin="4,2,12,2" Background="{StaticResource BorderBrush}" />
                        <RadioButton Grid.Column="3"
                                     GroupName="AppPreviewMode"
                                     Content="Desktop"
                                     IsChecked="True"
                                     Checked="DesktopPreview_Checked"
                                     Style="{StaticResource PreviewModeStyle}" />
                        <RadioButton Grid.Column="4"
                                     Margin="4,0,0,0"
                                     GroupName="AppPreviewMode"
                                     Content="Mobile"
                                     Checked="MobilePreview_Checked"
                                     Style="{StaticResource PreviewModeStyle}" />
                        <ComboBox x:Name="PhoneViewportPicker"
                                  Grid.Column="5"
                                  Width="250"
                                  Margin="8,0,0,0"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="False"
                                  SelectionChanged="PhoneViewportPicker_SelectionChanged"
                                  ToolTip="Choose a known phone CSS viewport" />
                        <StackPanel Grid.Column="6" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewSizeText" Margin="0,0,12,0" Foreground="{StaticResource BlueBrush}" Text="Responsive desktop" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding FrontendBrowserStatus}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Background="{StaticResource WindowBrush}">
                        <Border x:Name="AppPreviewFrame"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0">
                            <Grid>
                                <wv2:WebView2 x:Name="AppWebView"
                                              Source="{Binding FrontendSource}"
                                              Loaded="AppWebView_Loaded"
                                              NavigationCompleted="AppWebView_NavigationCompleted" />
                                <Border Background="{StaticResource SurfaceBrush}"
                                        Visibility="{Binding IsFrontendUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White" Text="Frontend unavailable" />
                                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding FrontendBrowserStatus}" />
                                        <Button Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding WebService.StartCommand}" Content="Start Web" Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
